#!/bin/bash
# rc.vgpu - runtime control for the my-unraid-vgpu-manager plugin
# Unified management of:
#   - NVIDIA vGPU (MERGED driver: vGPU + standard NVIDIA driver)
#   - Intel i915 (default) / experimental xe SR-IOV, as separate packages
#
# Drivers are NOT installed by default: the plugin page calls
#   rc.vgpu nvidia_install / nvidia_uninstall / intel_install / intel_uninstall
# to opt in. restore/ensure reinstall only those opted-in drivers from cache.
#
# usage: rc.vgpu <command>
#   restore      - reinstall opted-in packages for this kernel, without network
#   ensure       - restore and start opted-in stacks before VM autostart
#   start        - load modules, start daemons, apply configured devices
#   stop         - stop devices and daemons
#   restart      - stop + start
#   update       - apply verified cached packages to enabled stacks
#   apply        - (re)define and start all configured mdev devices
#   status       - print a short status summary
#   nvidia_install    - install a verified NVIDIA merged driver package
#   nvidia_uninstall  - stop devices/daemons and remove the NVIDIA package
#   nvidia_update     - live-install a newer downloaded NVIDIA package
#   nvidia_license    - (re)write gridd.conf from the page settings
#   license_retry     - retry licensing once a local license server is up
#   intel_install     - install a verified package for the selected Intel driver
#   intel_switch      - queue a verified i915/xe package for the next boot
#   intel_cancel_switch - cancel a switch before reboot, without runtime changes
#   intel_uninstall   - remove the selected Intel package
#   intel_set_vfs N   - set the VF count (hot)
#   intel_bind        - bind all VFs to vfio-pci
#
# Persistent configuration lives on the flash drive:
#   /boot/config/plugins/my-unraid-vgpu-manager/settings.cfg     - plugin settings
#   /boot/config/plugins/my-unraid-vgpu-manager/vgpu-devices.cfg - NVIDIA mdev devices
#   /boot/config/nvidia-vgpu/profile_override.toml               - vgpu_unlock overrides
#   /boot/config/nvidia-vgpu/vgpuConfig.xml                      - optional vgpuConfig.xml override

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../include/common.sh"
DEVCFG="${PLGCFG}/vgpu-devices.cfg"
USERCFG="/boot/config/nvidia-vgpu"
UNLOCK_DIR="/etc/vgpu_unlock"
UNLOCK_LIB="/usr/local/lib/libvgpu_unlock_rs.so"
XML_OVERRIDE="${USERCFG}/vgpuConfig.xml"
XML_TARGET="/usr/share/nvidia/vgpu/vgpuConfig.xml"
TYPES_TIMEOUT=60

log() {
  logger -t "${PLUGIN}" -- "$*"
  echo "$*"
}

pkg_file() {
  find_package nvidia "$KERNEL_V" "$(nvidia_series)" latest
}

intel_pkg_file() {
  find_package "$(intel_driver)" "$KERNEL_V"
}

pkg_version() {
  local p
  p="$(pkg_file)"
  [ -n "$p" ] && basename "$p" | cut -d '-' -f2
}

intel_pkg_version() {
  local p
  p="$(intel_pkg_file)"
  [ -n "$p" ] && basename "$p" | sed -E 's/^(i915|xe)-sriov-([0-9.]+)-.*/\2/'
}

installed_version() {
  modinfo -F version nvidia 2>/dev/null | head -1
}

loaded_version() {
  cat /sys/module/nvidia/version 2>/dev/null
}

intel_installed_version() {
  modinfo -F version "$(intel_driver)" 2>/dev/null | head -1
}

types_present() {
  ls -d /sys/bus/pci/devices/*/mdev_supported_types/nvidia-* >/dev/null 2>&1
}

# ============================================================================
# NVIDIA vGPU section
# ============================================================================

# write vgpu_unlock config and optional vgpuConfig.xml override; run before daemons
nvidia_setup_config() {
  mkdir -p "${USERCFG}" "${UNLOCK_DIR}" /boot/config/modprobe.d || return 1
  [ -f "${USERCFG}/profile_override.toml" ] || touch "${USERCFG}/profile_override.toml" || return 1
  ln -sf "${USERCFG}/profile_override.toml" "${UNLOCK_DIR}/profile_override.toml" || return 1
  local unlock
  unlock="$(setting nvidia_unlock)"
  [ -n "${unlock}" ] || unlock="$(setting unlock)"
  [ "${unlock}" = "true" ] || unlock="false"
  echo "unlock = ${unlock}" > "${UNLOCK_DIR}/config.toml" || return 1
  # Remove only the invalid option; retain the user's other module options.
  # (cudahost=1 is unknown to this driver and silently ignored)
  if [ -f /boot/config/modprobe.d/nvidia.conf ] && grep -q cudahost /boot/config/modprobe.d/nvidia.conf 2>/dev/null; then
    sed -i -E 's/(^|[[:space:]])cudahost=[^[:space:]]+/\1/g' /boot/config/modprobe.d/nvidia.conf
    log "Removed invalid cudahost option from /boot/config/modprobe.d/nvidia.conf"
  fi
  if [ -f "${XML_OVERRIDE}" ] && [ -d "$(dirname "${XML_TARGET}")" ]; then
    if ! cmp -s "${XML_OVERRIDE}" "${XML_TARGET}"; then
      log "Applying custom vgpuConfig.xml from ${XML_OVERRIDE}"
      cp -f "${XML_OVERRIDE}" "${XML_TARGET}" || return 1
    fi
  fi
  return 0
}

# The runtime token lives in RAM. A copy on the flash drive, tagged with its
# endpoint, lets boot restore licensing before a local license server (often a
# container or VM on this host) is running.
LICENSE_DIR="${PLGCFG}/license"
LICENSE_TOKEN="${LICENSE_DIR}/client_configuration_token.tok"
LICENSE_ENDPOINT="${LICENSE_DIR}/endpoint"

# apply the gridd.conf license settings from the plugin page (no external script needed)
# Supports FastAPI-DLS: fetch the client token from https://<addr>:<port>/-/client-token
# and point ClientConfigTokenPath at the directory holding it.
nvidia_apply_license() {
  local network="${1:-online}"
  local addr port feat verify conf old_addr old_port old_verify tmp token changed=0 endpoint
  local tok_dir=/etc/nvidia/ClientConfigToken tok_file
  local -a tls_args=()
  addr="$(setting nvidia_license_server)"
  port="$(setting nvidia_license_port)"; port="${port:-443}"
  feat="$(setting nvidia_feature_type)"; feat="${feat:-0}"
  verify="$(setting nvidia_license_verify)"
  conf=/etc/nvidia/gridd.conf
  tok_file="$tok_dir/client_configuration_token.tok"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$port))" -ge 1 ] && [ "$((10#$port))" -le 65535 ] || { log "ERROR: invalid license port"; return 1; }
  [[ "$feat" =~ ^[012]$ ]] || { log "ERROR: invalid license feature type"; return 1; }
  if [ -n "$addr" ] && ! [[ "$addr" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ || "$addr" =~ ^\[[0-9a-fA-F:]+\]$ ]]; then
    log "ERROR: enter a license hostname or IP address without a URL or path"
    return 1
  fi
  mkdir -p /etc/nvidia "$tok_dir" /var/lib/nvidia/GridLicensing || return 1
  endpoint="${addr}|${port}|${verify}"
  if [ -n "$addr" ] && [ ! -s "$tok_file" ] && [ -s "$LICENSE_TOKEN" ] &&
     [ "$(cat "$LICENSE_ENDPOINT" 2>/dev/null)" = "$endpoint" ]; then
    # After a reboot: reuse the saved token for the unchanged endpoint.
    cp -f "$LICENSE_TOKEN" "$tok_file" && chmod 0600 "$tok_file" || return 1
    old_addr="$addr"; old_port="$port"; old_verify="$verify"; changed=1
  else
    old_addr="$(sed -n 's/^ServerAddress=//p' "$conf" 2>/dev/null)"
    old_port="$(sed -n 's/^ServerPort=//p' "$conf" 2>/dev/null)"
    old_verify="$(sed -n 's/^# VerifyTLS=//p' "$conf" 2>/dev/null)"
  fi
  tmp="$(mktemp /etc/nvidia/.gridd.XXXXXX)" || return 1
  if [ -n "$addr" ] && { [ ! -s "$tok_file" ] || [ "$addr" != "$old_addr" ] || [ "$port" != "$old_port" ] || [ "$verify" != "$old_verify" ]; }; then
    if [ "$network" = offline ]; then
      rm -f "$tmp"
      log "License token acquisition deferred until the array has started"
      return 0
    fi
    token="$(mktemp "$tok_dir/.token.XXXXXX")" || { rm -f "$tmp"; return 1; }
    [ "$verify" = true ] || tls_args=(-k)
    if ! curl --proto '=https' -fsS --connect-timeout 8 --max-time 25 "${tls_args[@]}" \
        "https://${addr}:${port}/-/client-token" -o "$token" || [ ! -s "$token" ]; then
      rm -f "$tmp" "$token"
      log "ERROR: could not fetch the license token; existing runtime license configuration was retained"
      return 1
    fi
    chmod 0600 "$token" && mv -f "$token" "$tok_file" || { rm -f "$tmp" "$token"; return 1; }
    changed=1
  fi
  if [ -n "$addr" ] && { ! cmp -s "$tok_file" "$LICENSE_TOKEN" || [ "$(cat "$LICENSE_ENDPOINT" 2>/dev/null)" != "$endpoint" ]; }; then
    mkdir -p "$LICENSE_DIR" && cp -f "$tok_file" "$LICENSE_TOKEN" && printf '%s\n' "$endpoint" > "$LICENSE_ENDPOINT" ||
      log "WARNING: could not save the license token on the flash drive; it will be requested again after reboot"
  fi
  cat > "$tmp" <<EOF
# generated by my-unraid-vgpu-manager
# VerifyTLS=${verify}
ServerAddress=${addr}
ServerPort=${port}
FeatureType=${feat}
EnableUI=FALSE
EOF
  if [ -n "$addr" ]; then printf 'ClientConfigTokenPath=%s\n' "$tok_dir" >> "$tmp"; fi
  cmp -s "$tmp" "$conf" || changed=1
  chmod 0644 "$tmp" && mv -f "$tmp" "$conf" || return 1
  if [ "$changed" = 1 ] || [ -z "$addr" ]; then
    killall nvidia-gridd 2>/dev/null || true
    local attempt
    for ((attempt=0; attempt<10; attempt++)); do
      pgrep -x nvidia-gridd >/dev/null || break
      sleep 1
    done
    if pgrep -x nvidia-gridd >/dev/null; then
      log "ERROR: nvidia-gridd did not stop; retry applying the license settings"
      return 1
    fi
  fi
  if [ -z "$addr" ]; then
    rm -f "$tok_file"
    rm -rf "$LICENSE_DIR"
    return 0
  fi
  if ! pgrep -x nvidia-gridd >/dev/null; then
    command -v nvidia-gridd >/dev/null || return 1
    nvidia-gridd 9>&- </dev/null >/dev/null 2>&1 || { log "ERROR: nvidia-gridd did not start"; return 1; }
  fi
  return 0
}

# Licensing is still missing for an enabled, running NVIDIA stack.
license_pending() {
  [ "$(setting nvidia_installed)" = true ] && [ -n "$(setting nvidia_license_server)" ] &&
    nvidia_loaded && { ! pgrep -x nvidia-gridd >/dev/null || [ ! -s /etc/nvidia/ClientConfigToken/client_configuration_token.tok ]; }
}

# Started after the array is up. Retry without holding the operation lock, so
# the page stays usable while a local license server is still starting.
license_retry() {
  local attempt attempts="${1:-20}"
  for ((attempt=1; attempt<=attempts; attempt++)); do
    license_pending || return 0
    if /bin/bash "$0" nvidia_license >/dev/null 2>&1; then
      log "License settings applied after startup"
      return 0
    fi
    [ "$attempt" -eq "$attempts" ] || sleep 30
  done
  log "ERROR: the license server did not respond after startup; save the NVIDIA settings to retry"
  return 1
}

nvidia_load_modules() {
  modprobe nvidia && modprobe mdev && modprobe nvidia-vgpu-vfio || {
    log "ERROR: could not load the NVIDIA vGPU modules for $KERNEL_V"
    return 1
  }
  nvidia-modprobe >/dev/null 2>&1 || true
  local module key result=0
  for module in uvm modeset drm; do
    key="nvidia_load_${module}"
    if [ "$(setting "$key")" != false ]; then
      modprobe "nvidia-${module}" || result=1
    fi
  done
  return "$result"
}

nvidia_loaded() {
  [ -d /sys/module/nvidia ]
}

# Unload the whole nvidia driver stack.
unload_nvidia_stack() {
  modprobe -q -r nvidia_peermem 2>/dev/null
  modprobe -q -r nvidia_vgpu_vfio
  modprobe -q -r nvidia_drm
  modprobe -q -r nvidia_modeset
  modprobe -q -r nvidia_uvm
  rmmod nvidia 2>/dev/null
  ! nvidia_loaded
}

# The vGPU *type* list is latched into the RM inside nvidia.ko the first time
# nvidia-vgpud pushes it; reloading the whole driver is the only way to rebuild
# the profile list without a reboot.
reload_driver() {
  if ! nvidia_loaded; then
    return 0
  fi
  log "Reloading the nvidia driver stack so the vGPU profile list reflects the current config"
  if ! unload_nvidia_stack; then
    log "WARNING: could not unload the nvidia driver - the GPU is still in use."
    log "Stop your VMs and try again."
    return 1
  fi
}

daemons_stop() {
  killall nvidia-gridd 2>/dev/null
  killall nvidia-vgpu-mgr 2>/dev/null
  killall nvidia-vgpud 2>/dev/null
  local n=0
  while pgrep -x nvidia-vgpu-mgr >/dev/null || pgrep -x nvidia-vgpud >/dev/null || pgrep -x nvidia-gridd >/dev/null; do
    n=$((n + 1))
    if [ ${n} -ge 10 ]; then
      killall -9 nvidia-vgpu-mgr nvidia-vgpud nvidia-gridd 2>/dev/null
      break
    fi
    sleep 1
  done
  rm -f /var/run/nvidia-vgpud/*.pid /var/run/nvidia-vgpu-mgr/*.pid 2>/dev/null
}

daemons_start() {
  local unlock daemon
  unlock="$(setting nvidia_unlock)"; unlock="${unlock:-$(setting unlock)}"
  for daemon in nvidia-vgpud nvidia-vgpu-mgr; do
    pgrep -x "$daemon" >/dev/null && continue
    rm -f "/var/run/$daemon/"*.pid 2>/dev/null
    if [ "$unlock" = true ] && [[ "$(installed_version)" == 535.* ]] && [ -f "$UNLOCK_LIB" ]; then
      log "Starting $daemon (vgpu_unlock)"
      LD_PRELOAD="$UNLOCK_LIB" "$daemon" 9>&- </dev/null >/dev/null 2>&1 || return 1
    else
      log "Starting $daemon (native)"
      "$daemon" 9>&- </dev/null >/dev/null 2>&1 || return 1
    fi
  done
}

wait_types() {
  local t=0
  while ! types_present; do
    t=$((t + 1))
    if [ ${t} -ge ${TYPES_TIMEOUT} ]; then
      log "ERROR: no mdev types appeared after ${TYPES_TIMEOUT}s."
      log "If nvidia-vgpud logs 'GPU not supported by vGPU', this GPU is missing from the selected driver series."
      log "Check the selected driver series, loaded modules and GPU support. XML alone cannot add support to a newer driver."
      vgpu_notify "$(bilingual 'No vGPU profiles appeared. Check that the selected driver series supports this GPU.' '未出现 vGPU 配置档，请确认所选驱动系列支持这块显卡。')" alert >/dev/null
      return 1
    fi
    sleep 1
  done
  return 0
}

device_running() {
  [ -d "/sys/bus/mdev/devices/${1,,}" ]
}

# ============================================================================
# vGPU <-> VM attach/detach (mediated device via virsh)
# ============================================================================

# List all libvirt VMs, one per line (handles names containing spaces).
nvidia_list_vms() {
  virsh list --all --name 2>/dev/null | sed '/^[[:space:]]*$/d'
}

# Print the VM that currently has <uuid> in its persistent config, or nothing.
valid_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# Check both persistent and active XML: --config changes do not immediately
# appear in a running VM, and a detached live device remains busy until shutdown.
nvidia_vm_for_uuid() {
  local uuid="$1" mode="${2:-any}" vm xml
  valid_uuid "$uuid" || return 1
  while IFS= read -r vm; do
    [ -n "$vm" ] || continue
    if [ "$mode" != active ]; then
      xml="$(virsh dumpxml --inactive --domain "$vm" 2>/dev/null)"
      if grep -Eqi "<address[[:space:]][^>]*uuid=['\"]${uuid}['\"]" <<< "$xml"; then
        printf '%s\n' "$vm"; return 0
      fi
    fi
    # virsh list without --all returns all active domains, including paused VMs.
    if virsh list --name 2>/dev/null | grep -Fxq -- "$vm"; then
      xml="$(virsh dumpxml --domain "$vm" 2>/dev/null)"
      if grep -Eqi "<address[[:space:]][^>]*uuid=['\"]${uuid}['\"]" <<< "$xml"; then
        printf '%s\n' "$vm"; return 0
      fi
    fi
  done < <(nvidia_list_vms)
  return 1
}

nvidia_attach_vm() {
  local uuid="$1" vm="$2" tmp state out existing
  if ! valid_uuid "$uuid" || [ -z "$vm" ] || [[ "$vm" == *$'\n'* ]]; then
    echo "ERROR: usage: nvidia_attach_vm <uuid> <vm-name>"
    return 1
  fi
  if ! device_running "$uuid"; then
    echo "ERROR: vGPU $uuid is not running - start it first."
    return 1
  fi
  existing="$(nvidia_vm_for_uuid "$uuid")"
  if [ -n "$existing" ] && [ "$existing" != "$vm" ]; then
    echo "ERROR: vGPU $uuid is already attached to VM \"$existing\" - detach it first."
    return 1
  fi
  tmp="$(mktemp)" || return 1
  cat > "$tmp" <<EOF
<hostdev mode='subsystem' type='mdev' managed='no' model='vfio-pci'>
  <source>
    <address uuid='$uuid'/>
  </source>
</hostdev>
EOF
  out="$(virsh attach-device --domain "$vm" --file "$tmp" --config 2>&1)" || {
    echo "ERROR: failed to attach vGPU $uuid to VM \"$vm\": $out"
    rm -f "$tmp"
    return 1
  }
  rm -f "$tmp"
  state="$(virsh domstate --domain "$vm" 2>/dev/null)"
  log "Attached vGPU $uuid to VM $vm (persistent config)"
  echo "Attached vGPU $uuid to VM \"$vm\"."
  if [ "$state" != "shut off" ]; then
    echo "NOTE: VM \"$vm\" is running. Shut it down and start it again for the vGPU to appear."
  else
    echo "Start VM \"$vm\" to use the vGPU."
  fi
  return 0
}

# Detach a vGPU mdev from a VM's persistent config.
nvidia_detach_vm() {
  local uuid="$1" vm="$2" tmp state out
  if ! valid_uuid "$uuid" || [ -z "$vm" ] || [[ "$vm" == *$'\n'* ]]; then
    echo "ERROR: usage: nvidia_detach_vm <uuid> <vm-name>"
    return 1
  fi
  tmp="$(mktemp)" || return 1
  cat > "$tmp" <<EOF
<hostdev mode='subsystem' type='mdev' managed='no' model='vfio-pci'>
  <source>
    <address uuid='$uuid'/>
  </source>
</hostdev>
EOF
  out="$(virsh detach-device --domain "$vm" --file "$tmp" --config 2>&1)" || {
    echo "ERROR: failed to detach vGPU $uuid from VM \"$vm\": $out"
    rm -f "$tmp"
    return 1
  }
  rm -f "$tmp"
  state="$(virsh domstate --domain "$vm" 2>/dev/null)"
  log "Detached vGPU $uuid from VM $vm (persistent config)"
  echo "Detached vGPU $uuid from VM \"$vm\"."
  if [ "$state" != "shut off" ]; then
    echo "NOTE: VM \"$vm\" is running. Shut it down and start it again to fully release the vGPU."
  fi
  return 0
}

device_definition() {
  valid_uuid "$1" || return 1
  awk -F '|' -v uuid="$1" 'tolower($1) == tolower(uuid) {print; exit}' "$DEVCFG" 2>/dev/null
}

nvidia_add_device() {
  local uuid="${1,,}" pci="${2,,}" mtype="$3" available tmp
  valid_uuid "$uuid" && [[ "$pci" =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]] &&
    [[ "$mtype" =~ ^nvidia-[0-9]+$ ]] || { log "ERROR: invalid vGPU UUID, PCI address or profile"; return 1; }
  [ -z "$(device_definition "$uuid")" ] && ! device_running "$uuid" || { log "ERROR: vGPU UUID already exists"; return 1; }
  available="$(cat "/sys/bus/pci/devices/$pci/mdev_supported_types/$mtype/available_instances" 2>/dev/null)"
  [[ "$available" =~ ^[0-9]+$ ]] && [ "$available" -gt 0 ] || { log "ERROR: profile is unavailable on that GPU"; return 1; }
  mkdir -p "$PLGCFG" || return 1
  tmp="$(mktemp "$PLGCFG/.devices.XXXXXX")" || return 1
  if [ -f "$DEVCFG" ]; then cat "$DEVCFG" > "$tmp"; fi
  printf '%s|%s|%s\n' "$uuid" "$pci" "$mtype" >> "$tmp"
  if ! mdevctl define -u "$uuid" -p "$pci" --type "$mtype"; then rm -f "$tmp"; return 1; fi
  if ! mv -f "$tmp" "$DEVCFG"; then mdevctl undefine -u "$uuid"; rm -f "$tmp"; return 1; fi
  if ! mdevctl start -u "$uuid"; then log "ERROR: vGPU saved, but it could not start. Check the driver log and retry Start."; return 1; fi
  log "vGPU $uuid saved and started"
}

nvidia_start_device() {
  local row uuid pci mtype
  row="$(device_definition "$1")"
  [ -n "$row" ] || { log "ERROR: unknown vGPU UUID"; return 1; }
  IFS='|' read -r uuid pci mtype <<< "$row"
  device_running "$uuid" && return 0
  mdevctl define -u "$uuid" -p "$pci" --type "$mtype" || return 1
  mdevctl start -u "$uuid"
}

nvidia_stop_device() {
  local uuid="$1" owner
  valid_uuid "$uuid" && [ -n "$(device_definition "$uuid")" ] || { log "ERROR: unknown vGPU UUID"; return 1; }
  owner="$(nvidia_vm_for_uuid "$uuid" active)"
  [ -z "$owner" ] || { log "ERROR: vGPU is still in use by VM $owner. Shut it down first."; return 1; }
  if device_running "$uuid"; then mdevctl stop -u "$uuid" || return 1; fi
  return 0
}

nvidia_remove_device() {
  local uuid="$1" owner tmp
  valid_uuid "$uuid" && [ -n "$(device_definition "$uuid")" ] || { log "ERROR: unknown vGPU UUID"; return 1; }
  owner="$(nvidia_vm_for_uuid "$uuid")"
  [ -z "$owner" ] || { log "ERROR: vGPU is attached to VM $owner. Detach it and shut down the VM before removing it."; return 1; }
  nvidia_stop_device "$uuid" || return 1
  mdevctl undefine -u "$uuid" || return 1
  tmp="$(mktemp "$PLGCFG/.devices.XXXXXX")" || return 1
  if awk -F '|' -v uuid="$uuid" 'tolower($1) != tolower(uuid)' "$DEVCFG" > "$tmp"; then
    mv -f "$tmp" "$DEVCFG"
  else rm -f "$tmp"; return 1; fi
}

nvidia_apply_devices() {
  [ -s "${DEVCFG}" ] || return 0
  local uuid pci mtype rc=0
  while IFS='|' read -r uuid pci mtype; do
    case "${uuid}" in ''|\#*) continue ;; esac
    valid_uuid "$uuid" && [[ "$pci" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$ ]] && [[ "$mtype" =~ ^nvidia-[0-9]+$ ]] || { rc=1; continue; }
    if device_running "${uuid}"; then
      continue
    fi
    mdevctl define -u "${uuid}" -p "${pci}" --type "${mtype}" 2>/dev/null
    if mdevctl start -u "${uuid}" 2>/dev/null; then
      log "Started vGPU ${uuid} (${mtype} on ${pci})"
    else
      log "ERROR: failed to start vGPU ${uuid} (${mtype} on ${pci})"
      rc=1
    fi
  done < "${DEVCFG}"
  return ${rc}
}

nvidia_stop_devices() {
  [ -s "$DEVCFG" ] || return 0
  local uuid pci mtype owner result=0
  # Preflight the whole set before stopping any device.
  while IFS='|' read -r uuid pci mtype; do
    case "$uuid" in ''|\#*) continue ;; esac
    valid_uuid "$uuid" || continue
    owner="$(nvidia_vm_for_uuid "$uuid" active)"
    if [ -n "$owner" ]; then
      log "ERROR: vGPU $uuid is still in use by VM $owner. Shut down that VM first."
      return 1
    fi
  done < "$DEVCFG"
  while IFS='|' read -r uuid pci mtype; do
    case "$uuid" in ''|\#*) continue ;; esac
    valid_uuid "$uuid" || continue
    if device_running "$uuid"; then
      mdevctl stop -u "$uuid" || result=1
    fi
  done < "$DEVCFG"
  return "$result"
}

nvidia_setup_docker() {
  mkdir -p /etc/docker || return 1
  if [ -x /usr/bin/nvidia-ctk ]; then
    /usr/bin/nvidia-ctk runtime configure --runtime=docker >/dev/null 2>&1 \
      && log "Docker nvidia runtime configured" \
      || log "WARNING: nvidia-ctk runtime configure failed"
  fi
  # merge the nvidia runtime into an existing daemon.json - NEVER overwrite the
  # whole file (it may hold the user's registry-mirrors, data-root, ...)
  if [ -f /etc/docker/daemon.json ] && ! jq -e '.runtimes.nvidia.path | type == "string"' /etc/docker/daemon.json >/dev/null 2>&1; then
    if command -v jq >/dev/null 2>&1; then
      local tmp
      tmp="$(mktemp)"
      if jq '.runtimes = ((.runtimes // {}) + {nvidia: {path: "nvidia-container-runtime", runtimeArgs: []}})' \
           /etc/docker/daemon.json > "${tmp}" 2>/dev/null; then
        mv "${tmp}" /etc/docker/daemon.json
        log "Merged nvidia runtime into /etc/docker/daemon.json"
      else
        rm -f "${tmp}"
        log "WARNING: could not merge nvidia runtime into /etc/docker/daemon.json (invalid JSON?)"
      fi
    else
      log "WARNING: /etc/docker/daemon.json has no nvidia runtime and jq is missing - please merge it manually"
    fi
  elif [ ! -f /etc/docker/daemon.json ]; then
    cat > /etc/docker/daemon.json <<'EOF'
{
    "runtimes": {
        "nvidia": {
            "path": "nvidia-container-runtime",
            "runtimeArgs": []
        }
    }
}
EOF
    log "Wrote /etc/docker/daemon.json (nvidia runtime)"
  fi
}

nvidia_cleanup_runtime() {
  local conf=/etc/docker/daemon.json tmp
  if [ -f "$conf" ]; then
    tmp="$(mktemp /etc/docker/.vgpu-cleanup.XXXXXX)" || return 1
    if ! jq 'if (.runtimes.nvidia.path // "" | test("(^|/)nvidia-container-runtime$")) then
        del(.runtimes.nvidia) |
        if .["default-runtime"] == "nvidia" then del(.["default-runtime"]) else . end
      else . end' "$conf" > "$tmp"; then
      rm -f "$tmp"
      log "ERROR: could not clean the NVIDIA Docker runtime; daemon.json was retained"
      return 1
    fi
    if cmp -s "$tmp" "$conf"; then rm -f "$tmp"
    else chmod 0644 "$tmp" && mv -f "$tmp" "$conf" || { rm -f "$tmp"; return 1; }; fi
  fi
  if grep -qxF '# generated by my-unraid-vgpu-manager' /etc/nvidia/gridd.conf 2>/dev/null; then
    rm -f /etc/nvidia/gridd.conf /etc/nvidia/ClientConfigToken/client_configuration_token.tok
  fi
}

install_driver_package() (
  local source="$1" pkg="$2" name old target key other opposite
  check_conflicting_plugins "$source" || return 1
  mkdir -p "$PLGCFG" || return 1
  exec 5>"${PLGCFG}/.cache.lock"
  flock -s 5 || return 1
  name="${pkg##*/}"
  package_matches "$name" "$source" "$KERNEL_V" && package_ok "$pkg" || {
    log "ERROR: driver package has the wrong kernel/name or failed its checksum: $name"
    return 1
  }
  tar -tJf "$pkg" >/dev/null 2>&1 || { log "ERROR: invalid package archive: $name"; return 1; }
  old="$(installed_package "$source")"
  if valid_intel_driver "$source"; then
    other=i915; [ "$source" != i915 ] || other=xe
    opposite="$(installed_package "$other")"
    if [ -n "$opposite" ]; then
      [ -z "$old" ] || { log 'ERROR: both Intel packages are installed; reboot before repairing the driver selection'; return 1; }
      [ ! -d "/sys/module/$other" ] && [ ! -d /sys/module/intel_sriov_compat ] || {
        log 'ERROR: refusing to replace an Intel package while its driver/shared module is loaded; reboot first'; return 1;
      }
      old="$opposite"
    fi
  fi
  target="$pkg"
  [ -z "$old" ] || [ "$old" = "$name" ] || target="${old%.txz}%${pkg}"
  log "Installing driver package $name"
  /sbin/upgradepkg --install-new --reinstall "$target" || {
    log "ERROR: package installation failed: $name"; return 1;
  }
  depmod -a "$KERNEL_V" || return 1
  case "$source" in nvidia) key=nvidia_package ;; i915|xe) key=intel_package ;; esac
  set_setting "$key" "$name"
)

nvidia_install_pkg() {
  install_driver_package nvidia "$1"
}

nvidia_do_start() {
  check_conflicting_plugins nvidia || return 1
  [ -n "$(installed_version)" ] || { log "ERROR: no NVIDIA module installed for $KERNEL_V"; return 1; }
  if [ -z "$(nvidia_gpu_ids)" ]; then
    log "NVIDIA package installed; no NVIDIA GPU detected. It will activate when hardware is present."
    return 0
  fi
  nvidia_setup_config || return 1
  nvidia_load_modules || return 1
  nvidia_setup_docker || return 1
  nvidia_apply_license "${1:-online}" || log "WARNING: license settings could not be applied; check the license server"
  if ! pgrep -x nvidia-vgpud >/dev/null || ! pgrep -x nvidia-vgpu-mgr >/dev/null; then
    daemons_start || return 1
  fi
  wait_types && nvidia_apply_devices
}

stop_update_workloads() {
  local stack="$1" pci
  local -a devices=()
  if [ "$stack" = nvidia ]; then
    for pci in /sys/bus/pci/devices/*; do
      [ "$(cat "$pci/vendor" 2>/dev/null)" = 0x10de ] || continue
      case "$(cat "$pci/class" 2>/dev/null)" in 0x03*) devices+=("${pci##*/}") ;; esac
    done
  else
    while IFS= read -r pci; do [ -z "$pci" ] || devices+=("$pci"); done < <(intel_pf_pci; intel_vfs_pci)
    for pci in "/sys/bus/pci/drivers/$(intel_driver)"/????:??:??.?; do
      [ ! -e "$pci" ] || devices+=("${pci##*/}")
    done
  fi
  php "$EMHTTP/include/workloads.php" "$stack" "${devices[@]}"
}

nvidia_do_update() {
  local pkg="${1:-$(pkg_file)}" new
  check_conflicting_plugins nvidia || return 1
  package_matches "${pkg##*/}" nvidia "$KERNEL_V" && package_ok "$pkg" || { log "ERROR: no verified NVIDIA package for $KERNEL_V"; return 1; }
  new="${pkg##*/}"
  if [ "$(installed_package nvidia)" = "$new" ] && [ "$(loaded_version)" = "$(installed_version)" ]; then
    log "NVIDIA package $new is already installed and loaded"
    nvidia_do_start
    return $?
  fi
  if [ "${2:-}" = stop-workloads ]; then stop_update_workloads nvidia || return 1; fi
  nvidia_stop_devices || return 1
  daemons_stop
  if ! unload_nvidia_stack; then
    log "ERROR: NVIDIA is in use. Stop GPU VMs/containers and retry the update."
    nvidia_do_start || true
    return 1
  fi
  if ! nvidia_install_pkg "$pkg"; then
    nvidia_do_start || true
    return 1
  fi
  prune_cache "$KERNEL_V" "$pkg" || log "WARNING: could not prune the driver cache"
  nvidia_do_start || return 1
  log "NVIDIA package $new installed and running"
}

# With several Intel GPUs (for example an iGPU and an Arc card), manage the one
# that exposes SR-IOV; otherwise the first Intel display device.
intel_pf_pci() {
  local dev first=''
  for dev in /sys/bus/pci/devices/*; do
    [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x8086 ] || continue
    [ ! -L "$dev/physfn" ] || continue
    case "$(cat "$dev/class" 2>/dev/null)" in
      0x03*)
        if [ -e "$dev/sriov_totalvfs" ]; then printf '%s\n' "${dev##*/}"; return 0; fi
        [ -n "$first" ] || first="${dev##*/}" ;;
    esac
  done
  [ -n "$first" ] || return 1
  printf '%s\n' "$first"
}

intel_has_gpu() {
  [ -n "$(intel_pf_pci)" ]
}

intel_pf_driver() {
  local pf driver
  pf="$(intel_pf_pci)" || return 1
  driver="$(readlink "/sys/bus/pci/devices/$pf/driver" 2>/dev/null)"
  printf '%s\n' "${driver##*/}"
}

intel_other_gpus_bound() {
  local driver="$1" pf dev
  pf="$(intel_pf_pci)"
  for dev in "/sys/bus/pci/drivers/$driver"/????:??:??.?; do
    [ -e "$dev" ] || continue
    [ "${dev##*/}" = "$pf" ] && continue
    [ ! -L "$dev/physfn" ] || continue
    return 0
  done
  return 1
}

intel_reboot_notice() {
  log "$(bilingual 'Intel SR-IOV is installed and enabled for the next boot. Reboot to replace the busy stock driver; VFs are not active yet.' \
    'Intel SR-IOV 驱动已安装并设为开机启用。请重启以替换正在使用的原生驱动；VF 目前尚未生效。')"
}

intel_sriov_supported() {
  local pf
  pf="$(intel_pf_pci)"
  [ -n "${pf}" ] && lspci -vs "${pf}" 2>/dev/null | grep -q "SR-IOV"
}

intel_vfs_pci() {
  local pf vf
  pf="$(intel_pf_pci)" || return 1
  for vf in "/sys/bus/pci/devices/$pf"/virtfn*; do
    [ -L "$vf" ] || continue
    basename "$(readlink -f "$vf")"
  done | sort -V
}

intel_sysfs_base() {
  local pf
  pf="$(intel_pf_pci)" || return 1
  printf '/sys/bus/pci/devices/%s\n' "$pf"
}

intel_vfs_num() {
  local base
  base="$(intel_sysfs_base)"
  [ -n "${base}" ] && cat "${base}/sriov_numvfs" 2>/dev/null
}

intel_vfs_total() {
  local base
  base="$(intel_sysfs_base)"
  [ -n "${base}" ] && cat "${base}/sriov_totalvfs" 2>/dev/null
}

# write VF count to sysfs (hot-plug, no reboot needed if module already has VFs enabled)
intel_vfs_idle() {
  local vf group node
  command -v fuser >/dev/null || { log "ERROR: fuser is required to check whether Intel VFs are in use"; return 1; }
  for vf in $(intel_vfs_pci); do
    group="$(readlink -f "/sys/bus/pci/devices/$vf/iommu_group")"
    if [ -n "$group" ] && fuser -s "/dev/vfio/${group##*/}" 2>/dev/null; then
      log "ERROR: Intel VF $vf is in use. Shut down its VM first."
      return 1
    fi
    for node in "/sys/bus/pci/devices/$vf/vfio-dev"/*; do
      [ -e "$node" ] || continue
      if fuser -s "/dev/vfio/devices/${node##*/}" 2>/dev/null; then
        log "ERROR: Intel VF $vf is in use. Shut down its VM first."
        return 1
      fi
    done
  done
}

intel_set_vfs() {
  local num="$1" persist="${2:-save}" base total current
  [[ "$num" =~ ^[0-9]{1,2}$ ]] || { log "ERROR: invalid VF count"; return 1; }
  num="$((10#$num))"
  base="$(intel_sysfs_base)" || { log "ERROR: no Intel GPU found"; return 1; }
  [ -w "$base/sriov_numvfs" ] || { log "ERROR: the Intel driver is not exposing writable SR-IOV controls"; return 1; }
  total="$(cat "$base/sriov_totalvfs")"
  [[ "$total" =~ ^[0-9]+$ ]] && [ "$num" -le "$total" ] || { log "ERROR: VF count exceeds hardware limit ($total)"; return 1; }
  current="$(cat "$base/sriov_numvfs")"
  if [ "$current" != "$num" ]; then
    intel_vfs_idle || return 1
    if [ "$current" != 0 ]; then
      echo 0 > "$base/sriov_numvfs" || { log "ERROR: could not disable existing VFs"; return 1; }
    fi
    if ! echo "$num" > "$base/sriov_numvfs"; then
      log "ERROR: could not set VF count to $num"
      echo "$current" > "$base/sriov_numvfs" 2>/dev/null || true
      return 1
    fi
  fi
  intel_bind_all_vfio || return 1
  if [ "$persist" = save ]; then
    set_setting intel_vf_number "$num" || return 1
    if [ "$(setting intel_installed)" = true ]; then intel_write_config || return 1; fi
  fi
  return 0
}

intel_bind_vfio() {
  local pci="$1" dsp dpath dbdf curr
  dsp="/sys/bus/pci/devices/${pci}"
  [ -d "${dsp}" ] && [ -L "${dsp}/physfn" ] || { log "ERROR: ${pci} is not an Intel VF"; return 1; }
  [ "$(basename "$(readlink -f "${dsp}/physfn")")" = "$(intel_pf_pci)" ] || return 1
  dpath="${dsp}/driver"
  dbdf="${dsp##*/}"

  # vfio-pci must be loaded before anything can bind to it
  if ! lsmod | grep -qw vfio_pci; then
    modprobe vfio_pci 2>/dev/null || { log "ERROR: cannot load vfio-pci"; return 1; }
  fi
  echo "vfio-pci" > "${dsp}/driver_override" 2>/dev/null || return 1
  if [ -d "${dpath}" ]; then
    curr="$(readlink "${dpath}")"
    curr="${curr##*/}"
    if [ "${curr}" = "vfio-pci" ]; then
      log "${dbdf} already bound to vfio-pci"
      return 0
    fi
    log "Unbinding ${dbdf} from ${curr}"
    echo "${dbdf}" > "${dpath}/unbind" 2>/dev/null || return 1
  fi
  # bind explicitly instead of drivers_probe (which would probe every
  # driverless PCI device on the bus as a side effect)
  if echo "${dbdf}" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null; then
    log "${dbdf} bound to vfio-pci"
  else
    log "WARNING: could not bind ${dbdf} to vfio-pci"
    return 1
  fi
}

intel_bind_all_vfio() {
  local vf result=0
  for vf in $(intel_vfs_pci); do
    intel_bind_vfio "$vf" || result=1
  done
  return "$result"
}

intel_restore_go() {
  local go=/boot/config/go
  [ -f "$go" ] || return 0
  # Undo only the exact marker inserted by older versions of this plugin.
  sed -i 's/\bmodprobe i915_disabled_by_vgpu_plugin\b/modprobe i915/g' "$go"
}

intel_ccs_supported() {
  modinfo -p "${1:-$(intel_driver)}" 2>/dev/null | grep -q '^xelp_enable_ccs:'
}

intel_config_text() {
  local driver="$1" max_vfs ccs='' pf device other
  valid_intel_driver "$driver" || return 1
  max_vfs="$(setting intel_vf_number)"
  [ -n "$max_vfs" ] || max_vfs=7
  [[ "$max_vfs" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$max_vfs))" -le 63 ] || return 1
  if intel_ccs_supported "$driver"; then
    if [ "$(setting intel_xelp_enable_ccs)" = false ]; then ccs=' xelp_enable_ccs=0'; else ccs=' xelp_enable_ccs=1'; fi
  fi
  pf="$(intel_pf_pci)"
  device="$(cat "/sys/bus/pci/devices/$pf/device" 2>/dev/null)"; device="${device#0x}"
  other=xe; [ "$driver" != xe ] || other=i915
  printf '# Managed by my-unraid-vgpu-manager\nblacklist %s\n' "$driver"
  # Blacklist only the selected module's automatic load until cache restore.
  # The opposite driver remains available for other GPUs (never force_probe=*).
  if [[ "$device" =~ ^[0-9a-fA-F]{4}$ ]]; then printf 'options %s force_probe=!%s\n' "$other" "${device,,}"; fi
  if [ "$driver" = i915 ]; then
    printf 'options i915 enable_guc=3 max_vfs=%s%s\n' "$max_vfs" "$ccs"
  else
    printf 'options xe max_vfs=%s%s' "$max_vfs" "$ccs"
    if [[ "$device" =~ ^[0-9a-fA-F]{4}$ ]]; then printf ' force_probe=%s' "${device,,}"; fi
    printf '\n'
  fi
}

intel_save_config() {
  local driver="$1" directory="$2" tmp file="$2/my-unraid-vgpu-manager-i915.conf"
  mkdir -p "$directory" || return 1
  tmp="$(mktemp "$directory/.intel.XXXXXX")" || return 1
  intel_config_text "$driver" > "$tmp" || { rm -f "$tmp"; return 1; }
  if cmp -s "$tmp" "$file"; then rm -f "$tmp"; return 0; fi
  chmod 0644 "$tmp" && mv -f "$tmp" "$file"
}

intel_write_config() {
  local runtime="${1:-$(intel_driver)}" next
  next="$(intel_boot_driver)" || return 1
  intel_save_config "$next" /boot/config/modprobe.d && intel_save_config "$runtime" /etc/modprobe.d
}

intel_set_ccs() {
  case "$1" in true|false) ;; *) log 'ERROR: invalid CCS setting'; return 1 ;; esac
  set_setting intel_xelp_enable_ccs "$1" || return 1
  if intel_opted_in; then intel_write_config || return 1; fi
  if ! intel_ccs_supported "$(intel_boot_driver)"; then
    log 'WARNING: this driver does not support xelp_enable_ccs on disk; the preference is retained for supported modules.'
  fi
  log 'CCS setting saved. Reboot or reload the supported Intel driver to apply it; running VFs are unchanged.'
}

intel_load_module() {
  local driver="${1:-$(intel_driver)}" max_vfs owner pf device other
  local -a args=()
  valid_intel_driver "$driver" && check_conflicting_plugins "$driver" || return 1
  if [ -n "$(installed_package i915)" ] && [ -n "$(installed_package xe)" ]; then
    log 'ERROR: both Intel SR-IOV packages are installed. Reboot and restore only the selected driver before loading the shared compatibility module.'
    return 1
  fi
  owner="$(intel_pf_driver)"
  if [ -n "$owner" ] && [ "$owner" != "$driver" ]; then
    log "ERROR: Intel PF is bound to $owner, not $driver. Check boot options and reboot; no other driver will be unloaded."
    return 1
  fi
  max_vfs="$(setting intel_vf_number)"
  [ -n "${max_vfs}" ] || max_vfs="7"
  intel_write_config "$driver" || return 1
  args=(max_vfs="$max_vfs")
  if [ "$driver" = i915 ]; then args=(enable_guc=3 "${args[@]}")
  else
    pf="$(intel_pf_pci)"; device="$(cat "/sys/bus/pci/devices/$pf/device" 2>/dev/null)"; device="${device#0x}"
    if [[ "$device" =~ ^[0-9a-fA-F]{4}$ ]]; then args+=(force_probe="${device,,}"); fi
  fi
  if intel_ccs_supported "$driver"; then
    if [ "$(setting intel_xelp_enable_ccs)" = false ]; then
      args+=(xelp_enable_ccs=0)
    else
      args+=(xelp_enable_ccs=1)
    fi
  fi
  other=xe; [ "$driver" != xe ] || other=i915
  if [ -f "/sys/module/$other/parameters/max_vfs" ]; then
    log 'ERROR: another Intel SR-IOV driver is loaded; reboot before loading the selected driver and its shared compatibility module'
    return 1
  fi
  # Both community modules require this shim; never load it alongside the
  # other community driver's potentially incompatible copy.
  if ! modprobe intel_sriov_compat 2>/dev/null; then
    log "ERROR: intel_sriov_compat not found - run depmod -a and reinstall the ${driver}-sriov package"
    return 1
  fi
  if [ -d "/sys/module/$driver" ]; then
    if [ -f "/sys/module/$driver/parameters/max_vfs" ]; then
      log "$driver (SR-IOV) already loaded"
    else
      log "Unloading stock $driver (not SR-IOV) to load the SR-IOV build"
      if intel_other_gpus_bound "$driver" || ! modprobe -r "$driver" 2>/dev/null; then
        log "WARNING: could not unload stock $driver (in use or another GPU is bound) - reboot to apply SR-IOV"
        return 1
      fi
    fi
  fi
  if [ ! -f "/sys/module/$driver/parameters/max_vfs" ]; then
    log "Loading $driver with ${args[*]}"
    modprobe "$driver" "${args[@]}" 2>/dev/null || {
      log "ERROR: modprobe $driver failed - check the ${driver}-sriov package, GPU support and kernel log"
      return 1
    }
    sleep 3
  fi
  [ -f "/sys/module/$driver/parameters/max_vfs" ] || { log "ERROR: loaded $driver is not the SR-IOV module"; return 1; }
  if intel_has_gpu; then intel_set_vfs "$max_vfs" nosave || return 1; fi
  return 0
}

intel_install_pkg() {
  install_driver_package "${2:-$(intel_driver)}" "$1"
}

intel_do_ensure() {
  local driver owner
  if [ -n "$(intel_pending_driver)" ] && intel_switch_due; then intel_apply_switch; return $?; fi
  [ "$(setting intel_installed)" = true ] || return 0
  driver="$(intel_driver)" || return 1
  intel_has_gpu || { log "No Intel GPU detected; keeping the installed package for later use"; return 0; }
  owner="$(intel_pf_driver)"
  if [ "$(setting intel_pending_reboot)" = true ] &&
     { { [ -d "/sys/module/$driver" ] && [ ! -f "/sys/module/$driver/parameters/max_vfs" ]; } || { [ -n "$owner" ] && [ "$owner" != "$driver" ]; }; }; then
    intel_reboot_notice
    return 0
  fi
  intel_load_module "$driver" || return 1
  if [ "$(setting intel_pending_reboot)" = true ]; then set_setting intel_pending_reboot false || return 1; fi
  return 0
}

do_start() {
  local result=0
  if [ "$(setting nvidia_installed)" = true ]; then nvidia_do_start || result=1; fi
  if intel_opted_in; then intel_do_ensure || result=1; fi
  return "$result"
}

do_stop() {
  nvidia_stop_devices || return 1
  daemons_stop
}

do_restart() {
  do_stop || return 1
  if ! reload_driver; then nvidia_do_start || true; return 1; fi
  # Restarting NVIDIA services must not tear down Intel VFs.
  nvidia_do_start
}

do_update() {
  local nrc=0 irc=0
  if [ "$(setting nvidia_installed)" = "true" ] && [ -n "$(pkg_file)" ]; then
    nvidia_do_update || nrc=1
  fi
  if [ "$(setting intel_installed)" = "true" ] && intel_has_gpu && [ -n "$(intel_pkg_file)" ]; then
    intel_do_install || irc=1
  fi
  [ ${nrc} -eq 0 ] && [ ${irc} -eq 0 ]
}

# --- on-demand install / uninstall (called from the plugin page) ---

nvidia_do_install() {
  local pkg="${1:-$(pkg_file)}"
  check_conflicting_plugins nvidia || return 1
  package_matches "${pkg##*/}" nvidia "$KERNEL_V" && package_ok "$pkg" || { log "ERROR: no verified NVIDIA package for $KERNEL_V"; return 1; }
  if [ -n "$(loaded_version)" ]; then
    nvidia_do_update "$pkg" || return 1
  else
    nvidia_install_pkg "$pkg" || return 1
    # The flag records opt-in even if hardware activation subsequently fails.
    set_setting nvidia_installed true || return 1
    prune_cache "$KERNEL_V" "$pkg" || log "WARNING: could not prune the driver cache"
    nvidia_do_start || return 1
  fi
  set_setting nvidia_installed true
}

nvidia_do_uninstall() {
  nvidia_stop_devices || return 1
  daemons_stop
  if ! unload_nvidia_stack; then
    log "ERROR: NVIDIA is in use. Stop GPU VMs/containers before uninstalling."
    nvidia_do_start || true
    return 1
  fi
  nvidia_cleanup_runtime || return 1
  local pkg
  pkg="$(installed_package nvidia)"
  if [ -n "$pkg" ]; then removepkg "${pkg%.txz}" || return 1; fi
  depmod -a "$KERNEL_V" || return 1
  set_setting nvidia_installed false || return 1
  log "NVIDIA vGPU driver disabled and uninstalled"
}

intel_unload_stack() {
  local driver="${1:-$(intel_driver)}" owner other
  valid_intel_driver "$driver" || return 1
  owner="$(intel_pf_driver)"
  if [ -n "$owner" ] && [ "$owner" != "$driver" ]; then
    intel_vfs_idle || return 1
    return 2
  fi
  if intel_other_gpus_bound "$driver"; then
    log "ERROR: another GPU uses $driver; refusing a global module unload"
    return 1
  fi
  other=xe; [ "$driver" != xe ] || other=i915
  if [ -f "/sys/module/$other/parameters/max_vfs" ]; then
    log 'ERROR: another SR-IOV driver uses the shared compatibility module; reboot before changing packages'
    return 1
  fi
  if [ -n "$(intel_vfs_total)" ]; then intel_set_vfs 0 nosave || return 1; fi
  if [ -d "/sys/module/$driver" ]; then
    if ! modprobe -r "$driver"; then
      if [ ! -f "/sys/module/$driver/parameters/max_vfs" ]; then return 2; fi
      log "ERROR: Intel GPU is in use; stop its VMs/containers before changing the driver"
      return 1
    fi
  fi
  if [ -d /sys/module/intel_sriov_compat ]; then modprobe -r intel_sriov_compat || return 1; fi
  return 0
}

intel_queue_switch() (
  local driver="$1" pkg="$2" id active previous rollback next pf dev device
  valid_intel_driver "$driver" && check_conflicting_plugins "$driver" || return 1
  id="$(boot_id)" && active="$(intel_driver)" && previous="$(intel_boot_driver)" || return 1
  pf="$(intel_pf_pci)"; device="$(cat "/sys/bus/pci/devices/$pf/device" 2>/dev/null)"
  # force_probe addresses device IDs, not BDFs: identical PFs cannot be
  # excluded independently without a separate per-device binding strategy.
  if [ -n "$device" ]; then
    for dev in /sys/bus/pci/devices/*; do
      [ "${dev##*/}" != "$pf" ] && [ ! -L "$dev/physfn" ] || continue
      if [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x8086 ] && [ "$(cat "$dev/device" 2>/dev/null)" = "$device" ]; then
        log 'ERROR: multiple Intel PFs share this device ID; force_probe cannot safely switch just one of them'
        return 1
      fi
    done
  fi
  mkdir -p "$PLGCFG" || return 1
  exec 5>"${PLGCFG}/.cache.lock"; flock -s 5 || return 1
  package_matches "${pkg##*/}" "$driver" "$KERNEL_V" && package_ok "$pkg" && tar -tJf "$pkg" >/dev/null 2>&1 || {
    log 'ERROR: the selected Intel driver needs a verified package for the running kernel'; return 1;
  }
  # Offline boot restoration reads the cache, not an arbitrary supplied path.
  [ "$(readlink -f "$pkg")" = "$(package_dir "$KERNEL_V")/${pkg##*/}" ] || return 1
  next="$(php "$EMHTTP/include/kernel.php" 2>/dev/null)"
  if valid_kernel "$next" && [ "$next" != "$KERNEL_V" ]; then
    find_package "$driver" "$next" >/dev/null || { log "ERROR: prepare $driver for the next boot kernel $next first"; return 1; }
  fi
  rollback="$(setting intel_rollback_package)"
  if [ "$driver" != "$active" ] && [ "$(setting intel_installed)" = true ]; then
    rollback="$(installed_package "$active")"
    [ -n "$rollback" ] || rollback="$(setting intel_package)"
    find_package "$active" "$KERNEL_V" >/dev/null || { log 'ERROR: keep a verified rollback package before switching'; return 1; }
  fi
  # Only the next-boot file changes here. Running modules, VFs, /etc modprobe
  # settings and packages are deliberately untouched.
  intel_save_config "$driver" /boot/config/modprobe.d || return 1
  if ! set_settings intel_pending_driver "$driver" intel_pending_boot_id "$id" \
      intel_pending_package "${pkg##*/}" intel_rollback_package "$rollback"; then
    if intel_opted_in; then intel_save_config "$previous" /boot/config/modprobe.d
    else rm -f /boot/config/modprobe.d/my-unraid-vgpu-manager-i915.conf; fi
    return 1
  fi
  log "$(bilingual "Queued $driver for the next boot. No running GPU workloads were changed. Reboot to activate; i915 remains the recommended default, xe is experimental." \
    "已准备 $driver，将在下次重启时生效；未改变正在运行的 GPU 工作负载。建议默认使用 i915，xe 为实验性驱动。")"
)

intel_clear_switch() {
  set_settings intel_pending_driver '' intel_pending_boot_id '' intel_pending_package ''
}

intel_cancel_switch() {
  local pending active
  pending="$(intel_pending_driver)"; active="$(intel_driver)" || return 1
  [ -n "$pending" ] || return 0
  if [ "$(setting intel_pending_boot_id)" != "$(boot_id)" ]; then
    log 'ERROR: this switch has passed its reboot boundary. Select the desired driver and reboot again instead of cancelling.'
    return 1
  fi
  if [ "$(setting intel_installed)" = true ]; then intel_save_config "$active" /boot/config/modprobe.d || return 1
  else rm -f /boot/config/modprobe.d/my-unraid-vgpu-manager-i915.conf || return 1; fi
  if ! intel_clear_switch; then intel_save_config "$pending" /boot/config/modprobe.d; return 1; fi
  log "$(bilingual 'Queued Intel driver switch cancelled. Running modules and VFs are unchanged.' '已取消待重启的 Intel 驱动切换，运行中的模块和 VF 保持不变。')"
}

intel_apply_switch() {
  local driver pkg name owner other
  intel_switch_due || return 0
  driver="$(intel_pending_driver)"
  check_conflicting_plugins "$driver" || return 1
  if [ -n "$(installed_package i915)" ] && [ -n "$(installed_package xe)" ]; then
    log 'ERROR: both Intel SR-IOV packages are installed; reboot into a clean root filesystem before switching'
    return 1
  fi
  name="$(setting intel_pending_package)"
  if package_matches "$name" "$driver" "$KERNEL_V"; then pkg="$(package_dir "$KERNEL_V")/$name"
  else pkg="$(find_package "$driver" "$KERNEL_V")"; fi
  package_matches "${pkg##*/}" "$driver" "$KERNEL_V" && package_ok "$pkg" || {
    log "ERROR: queued $driver switch has no verified package for $KERNEL_V; selection is retained, prepare the package or queue i915 and reboot"
    return 1
  }
  owner="$(intel_pf_driver)"; other=xe; [ "$driver" != xe ] || other=i915
  if { [ -n "$owner" ] && [ "$owner" != "$driver" ]; } || [ -f "/sys/module/$other/parameters/max_vfs" ]; then
    log "ERROR: another driver owns the Intel PF/shared module. Correct boot options and reboot; the queued switch was not applied."
    return 1
  fi
  if [ "$(installed_package "$driver")" != "${pkg##*/}" ]; then
    if [ -d "/sys/module/$driver" ] || [ -d /sys/module/intel_sriov_compat ]; then
      log 'ERROR: Intel modules loaded before package restoration. Reboot without manual modprobe commands; no live package replacement was attempted.'
      return 1
    fi
    intel_install_pkg "$pkg" "$driver" || return 1
  fi
  depmod -a "$KERNEL_V" || return 1
  intel_write_config "$driver" || return 1
  if intel_has_gpu; then intel_load_module "$driver" || return 1; fi
  # Commit only after activation succeeds. On failure, retain the request and
  # rollback cache; do not claim a successful switch or automatically hot-swap.
  set_settings intel_driver "$driver" intel_installed true intel_pending_driver '' \
    intel_pending_boot_id '' intel_pending_package '' intel_pending_reboot false || return 1
  log "Intel $driver SR-IOV selection activated after reboot"
}

intel_do_install() {
  local pkg="${1:-$(intel_pkg_file)}" current unload_result driver
  driver="$(intel_driver)" || return 1
  [ -z "$(intel_pending_driver)" ] || { log 'ERROR: cancel or complete the queued driver switch before installing/updating'; return 1; }
  check_conflicting_plugins "$driver" || return 1
  package_matches "${pkg##*/}" "$driver" "$KERNEL_V" && package_ok "$pkg" || { log "ERROR: no verified $driver package for $KERNEL_V"; return 1; }
  current="$(installed_package "$driver")"
  if [ "$current" != "${pkg##*/}" ]; then
    if [ "${2:-}" = stop-workloads ]; then stop_update_workloads intel || return 1; fi
    if intel_unload_stack "$driver"; then :
    else
      unload_result=$?
      # Only a first install may stage a replacement for a busy stock driver.
      # Never bypass occupancy checks when updating an enabled SR-IOV stack.
      if [ "$unload_result" = 2 ] && [ -z "$current" ] && [ "$(setting intel_installed)" != true ]; then
        intel_install_pkg "$pkg" && intel_write_config && set_setting intel_pending_reboot true &&
          set_setting intel_installed true || return 1
        prune_cache "$KERNEL_V" "$pkg" || log "WARNING: could not prune the driver cache"
        intel_reboot_notice
        return 0
      fi
      log "ERROR: Intel GPU is in use; stop its VMs/containers before changing the driver"
      [ "$(setting intel_installed)" != true ] || intel_do_ensure || true
      return 1
    fi
    if ! intel_install_pkg "$pkg"; then intel_do_ensure || true; return 1; fi
  fi
  set_setting intel_installed true || return 1
  prune_cache "$KERNEL_V" "$pkg" || log "WARNING: could not prune the driver cache"
  intel_do_ensure
}

intel_do_uninstall() {
  local pkg driver
  driver="$(intel_driver)" || return 1
  if [ -n "$(intel_pending_driver)" ]; then intel_cancel_switch || return 1; fi
  if [ "$(setting intel_pending_reboot)" != true ] || [ -f "/sys/module/$driver/parameters/max_vfs" ]; then
    intel_unload_stack "$driver" || return 1
  fi
  pkg="$(installed_package "$driver")"
  if [ -n "$pkg" ]; then removepkg "${pkg%.txz}" || return 1; fi
  rm -f /boot/config/modprobe.d/my-unraid-vgpu-manager-i915.conf /etc/modprobe.d/my-unraid-vgpu-manager-i915.conf
  intel_restore_go || return 1
  depmod -a "$KERNEL_V" || return 1
  set_setting intel_installed false || return 1
  set_setting intel_pending_reboot false || return 1
  log "Intel $driver SR-IOV driver disabled and uninstalled"
  # Give the host its stock driver back instead of leaving the GPU unbound.
  if intel_has_gpu; then
    if modprobe i915 2>/dev/null; then log "Loaded the stock i915 driver"
    else log "WARNING: the stock i915 driver could not be loaded; reboot to restore the host Intel GPU"; fi
    modprobe xe 2>/dev/null || log "WARNING: xe could not be loaded; reboot if another Intel GPU needs it"
  fi
  return 0
}

do_restore() {
  local pkg series result=0 want driver
  record_running_kernel || return 1
  # Unraid rebuilds its root filesystem at boot. Restore only opted-in drivers
  # from verified packages for the running kernel, without network access.
  if [ "$(setting nvidia_installed)" = true ] && [ -z "$(installed_package nvidia)" ]; then
    series="$(nvidia_active_series)"
    want="$(setting driver_version)"; want="${want:-latest}"
    pkg="$(find_package nvidia "$KERNEL_V" "$series" "$want")"
    if [ -n "$pkg" ]; then nvidia_install_pkg "$pkg" || result=1
    else log "ERROR: no verified NVIDIA $series.x package for $KERNEL_V; prepare it before upgrading Unraid"; result=1; fi
  fi
  if intel_switch_due; then
    # ensure/starting activates this before VM autostart. Do not restore the
    # old driver here, and never consume a pending switch on a plugin upgrade.
    log 'Queued Intel driver will be restored and activated before array startup'
  elif [ "$(setting intel_installed)" = true ]; then
    driver="$(intel_driver)" || return 1
    if ! check_conflicting_plugins "$driver"; then result=1
    else
      if [ -z "$(installed_package "$driver")" ]; then
        pkg="$(find_package "$driver" "$KERNEL_V")"
        if [ -n "$pkg" ]; then intel_install_pkg "$pkg" || result=1
        else log "ERROR: no verified Intel package for $KERNEL_V; prepare it before upgrading Unraid"; result=1; fi
      fi
      # Migrate old global xe blacklists during plugin upgrades, even when the
      # running driver's package does not need reinstalling.
      if [ -n "$(installed_package "$driver")" ]; then intel_write_config || result=1; fi
    fi
  fi
  return "$result"
}

do_ensure() {
  local result=0
  do_restore || result=1
  if [ "$(setting nvidia_installed)" = true ] && [ -n "$(installed_package nvidia)" ]; then
    nvidia_do_start offline || result=1
  fi
  if intel_switch_due || { [ "$(setting intel_installed)" = true ] && [ -n "$(installed_package "$(intel_driver)")" ]; }; then
    intel_do_ensure || result=1
  fi
  return "$result"
}

do_status() {
  echo "Kernel:            ${KERNEL_V}"
  echo
  echo "== NVIDIA vGPU =="
  echo "Installed driver:  $(installed_version || echo none)"
  echo "Loaded driver:     $(loaded_version || echo 'not loaded')"
  echo "Downloaded pkg:    $(pkg_version || echo none)"
  echo "nvidia-vgpu-mgr:   $(pgrep -x nvidia-vgpu-mgr >/dev/null && echo running || echo stopped)"
  echo "mdev types:        $(types_present && echo available || echo 'not available')"
  echo "docker runtime:    $(grep -q '"nvidia"' /etc/docker/daemon.json 2>/dev/null && echo configured || echo not-configured)"
  echo "license server:    $(grep '^ServerAddress=' /etc/nvidia/gridd.conf 2>/dev/null | cut -d= -f2 || echo not-set)"
  echo "Configured vGPUs:"
  if [ -s "${DEVCFG}" ]; then
    local uuid pci mtype state
    while IFS='|' read -r uuid pci mtype; do
      case "${uuid}" in ''|\#*) continue ;; esac
      device_running "${uuid}" && state="running" || state="stopped"
      echo "  ${uuid}  ${pci}  ${mtype}  ${state}"
    done < "${DEVCFG}"
  else
    echo "  (none)"
  fi
  echo
  echo "== Intel SR-IOV =="
  echo "Selected driver:   $(intel_driver)"
  echo "Next boot driver:  $(intel_boot_driver)"
  if intel_has_gpu; then
    local pf
    pf="$(intel_pf_pci)"
    echo "Intel GPU (PF):    ${pf}"
    echo "Module on disk:    $(intel_installed_version || echo not-installed)"
    echo "PF driver:         $(intel_pf_driver)"
    echo "SR-IOV support:    $(intel_sriov_supported && echo yes || echo no)"
    echo "VFs:               $(intel_vfs_num || echo 0) / $(intel_vfs_total || echo 0)"
    echo "VF devices:"
    local vf
    for vf in $(intel_vfs_pci); do
      local drv
      drv="$(readlink "/sys/bus/pci/devices/${vf}/driver" 2>/dev/null)"
      echo "  ${vf}  ${drv##*/}"
    done
  else
    echo "  (no Intel GPU detected)"
  fi
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi
case "${1:-}" in status|license_retry) ;; *) operation_lock || exit 1 ;; esac
case "${1:-}" in
  restore)         do_restore && prune_cache ;;
  ensure)          do_ensure ;;
  start)           do_start ;;
  stop)            do_stop ;;
  restart)         do_restart ;;
  update)          do_update ;;
  apply)           nvidia_setup_config && nvidia_apply_devices ;;
  status)          do_status ;;
  nvidia_install)    nvidia_do_install "${2:-}" ;;
  nvidia_uninstall)  nvidia_do_uninstall ;;
  nvidia_start)      nvidia_do_start ;;
  nvidia_update)     nvidia_do_update "${2:-}" "${3:-}" ;;
  intel_update)      intel_do_install "${2:-}" stop-workloads ;;
  intel_set_ccs)     intel_set_ccs "${2:-}" ;;
  nvidia_license)    nvidia_apply_license ;;
  license_retry)     license_retry "${2:-}" ;;
  nvidia_add_device) nvidia_add_device "${2:-}" "${3:-}" "${4:-}" ;;
  nvidia_start_device) nvidia_start_device "${2:-}" ;;
  nvidia_stop_device) nvidia_stop_device "${2:-}" ;;
  nvidia_remove_device) nvidia_remove_device "${2:-}" ;;
  nvidia_attach_vm)  nvidia_attach_vm "${2:-}" "${3:-}" ;;
  nvidia_detach_vm)  nvidia_detach_vm "${2:-}" "${3:-}" ;;
  intel_install)     intel_do_install "${2:-}" ;;
  intel_switch)      intel_queue_switch "${2:-}" "${3:-}" ;;
  intel_cancel_switch) intel_cancel_switch ;;
  intel_uninstall)   intel_do_uninstall ;;
  intel_ensure)      intel_do_ensure ;;
  intel_load)        intel_load_module ;;
  intel_set_vfs)     intel_set_vfs "$2" ;;
  intel_bind)      intel_bind_all_vfio ;;
  *) echo "usage: $0 <ensure|start|stop|restart|update|apply|status|nvidia_*|intel_*>"; exit 1 ;;
esac
