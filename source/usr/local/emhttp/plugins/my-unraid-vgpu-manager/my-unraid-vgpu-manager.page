$gpus = []; $gpu_ids = []; $gpu_types = []; $types_present = false; $intel_pf = '';
foreach (glob('/sys/bus/pci/devices/*') ?: [] as $dev) {
    $vendor = vgpu_read("$dev/vendor"); $class = vgpu_read("$dev/class");
    if (strpos($class, '0x03') !== 0) continue;
    $pci = basename($dev);
    if ($vendor === '0x8086' && !is_link("$dev/physfn") && $intel_pf === '') $intel_pf = $pci;
    if ($vendor !== '0x10de') continue;
    $name = vgpu_run(['lspci', '-D', '-s', $pci]);
    $gpus[$pci] = $name['code'] === 0 && $name['output'] !== '' ? $name['output'] : 'NVIDIA GPU';
    if (!is_link("$dev/physfn")) $gpu_ids[$pci] = strtolower(vgpu_read("$dev/device"));
    $gpu_types[$pci] = [];
    foreach (glob("$dev/mdev_supported_types/nvidia-*") ?: [] as $tdir) {
        $types_present = true; $info = [];
        foreach (preg_split('/,\s*/', vgpu_read("$tdir/description")) as $pair) {
            $parts = explode('=', $pair, 2);
            if (count($parts) === 2) $info[trim($parts[0])] = trim($parts[1]);
        }
        $gpu_types[$pci][] = ['type'=>basename($tdir), 'name'=>vgpu_read("$tdir/name"),
            'avail'=>vgpu_read("$tdir/available_instances"), 'fb'=>$info['framebuffer'] ?? '',
            'heads'=>$info['num_heads'] ?? '', 'res'=>$info['max_resolution'] ?? '', 'frl'=>$info['frl_config'] ?? ''];
    }
    usort($gpu_types[$pci], fn($a,$b) => strnatcmp($a['name'], $b['name']));
}
$gpu_map = json_decode(file_get_contents("$vgpu_emhttp/include/gpu-series.json"), true);
$cap16 = $gpu_ids && !array_diff($gpu_ids, $gpu_map['16']);
$cap19 = $gpu_ids && !array_diff($gpu_ids, $gpu_map['19']);
$series_caps = $cap16 && $cap19 ? 'both' : ($cap16 ? '16' : ($cap19 ? '19' : 'none'));
$series_sel = vgpu_setting('nvidia_series', 'auto');
$series_eff = in_array($series_sel, ['16','19'], true) ? $series_sel : ($cap19 ? '19' : '16');
$series_inst = strpos($installed_v, '580.') === 0 ? '19' : (strpos($installed_v, '535.') === 0 ? '16' : '');
$install_choices = $cap16 && $cap19 ? ['19','16'] : ($cap16 ? ['16'] : ($cap19 ? ['19'] : ['16','19']));
