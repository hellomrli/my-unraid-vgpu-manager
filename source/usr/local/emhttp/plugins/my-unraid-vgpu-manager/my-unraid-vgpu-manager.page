<?php
require_once '/usr/local/emhttp/plugins/my-unraid-vgpu-manager/include/web.php';
$kernel = vgpu_command_text(['uname', '-r']);
$unraid_v = (@parse_ini_file('/etc/unraid-version') ?: [])['version'] ?? '';
$nvidia_inst = vgpu_setting('nvidia_installed', 'false') === 'true';
$intel_inst = vgpu_setting('intel_installed', 'false') === 'true';
$module_info = vgpu_run(['modinfo', '-F', 'version', 'nvidia']);
$installed_v = $module_info['code'] === 0 ? $module_info['output'] : '';
$loaded_v = vgpu_read('/sys/module/nvidia/version');
$i915_loaded = is_dir('/sys/module/i915');
$i915_sriov = is_file('/sys/module/i915/parameters/max_vfs');
$mgr_running = vgpu_run(['pgrep', '-x', 'nvidia-vgpu-mgr'])['code'] === 0;
$gpus = []; $gpu_ids = []; $gpu_types = []; $types_present = false; $intel_pf = '';
foreach (glob('/sys/bus/pci/devices/*') ?: [] as $dev) {
    $vendor = vgpu_read("$dev/vendor"); $class = vgpu_read("$dev/class");
    if (strpos($class, '0x03') !== 0) continue;
    $pci = basename($dev);
    if ($vendor === '0x8086' && !is_link("$dev/physfn") && $intel_pf === '') $intel_pf = $pci;
    if ($vendor !== '0x10de') continue;
    $name = vgpu_run(['lspci', '-D', '-s', $pci]);
    $gpus[$pci] = $name['code'] === 0 && $name['output'] !== '' ? $name['output'] : 'NVIDIA GPU';
    if (!is_link("$dev/physfn")) $gpu_ids[$pci] = strtolower(vgpu_read("$dev/device"));
    $gpu_types[$pci] = [];
    foreach (glob("$dev/mdev_supported_types/nvidia-*") ?: [] as $tdir) {
        $types_present = true; $info = [];
        foreach (preg_split('/,\s*/', vgpu_read("$tdir/description")) as $pair) {
            $parts = explode('=', $pair, 2);
            if (count($parts) === 2) $info[trim($parts[0])] = trim($parts[1]);
        }
        $gpu_types[$pci][] = ['type'=>basename($tdir), 'name'=>vgpu_read("$tdir/name"),
            'avail'=>vgpu_read("$tdir/available_instances"), 'fb'=>$info['framebuffer'] ?? '',
            'heads'=>$info['num_heads'] ?? '', 'res'=>$info['max_resolution'] ?? '', 'frl'=>$info['frl_config'] ?? ''];
    }
    usort($gpu_types[$pci], fn($a,$b) => strnatcmp($a['name'], $b['name']));
}
$gpu_map = json_decode(file_get_contents("$vgpu_emhttp/include/gpu-series.json"), true);
$cap16 = $gpu_ids && !array_diff($gpu_ids, $gpu_map['16']);
$cap19 = $gpu_ids && !array_diff($gpu_ids, $gpu_map['19']);
$series_caps = $cap16 && $cap19 ? 'both' : ($cap16 ? '16' : ($cap19 ? '19' : 'none'));
$series_sel = vgpu_setting('nvidia_series', 'auto');
$series_eff = in_array($series_sel, ['16','19'], true) ? $series_sel : ($cap19 ? '19' : '16');
$series_inst = strpos($installed_v, '580.') === 0 ? '19' : (strpos($installed_v, '535.') === 0 ? '16' : '');
$install_choices = $cap16 && $cap19 ? ['19','16'] : ($cap16 ? ['16'] : ($cap19 ? ['19'] : ['16','19']));
$vm_list = vgpu_vms(); $mdev_to_vm = []; $live_mdev_to_vm = [];
$active_vms = explode("\n", vgpu_command_text(['virsh', 'list', '--name']));
foreach ($vm_list as $vm) {
    foreach (vgpu_xml_mdevs(vgpu_command_text(['virsh','dumpxml','--inactive','--domain',$vm])) as $uuid) $mdev_to_vm[$uuid][] = $vm;
    if (in_array($vm, $active_vms, true)) {
        foreach (vgpu_xml_mdevs(vgpu_command_text(['virsh','dumpxml','--domain',$vm])) as $uuid) $live_mdev_to_vm[$uuid][] = $vm;
    }
}
$devices = vgpu_devices();
$intel_base = $intel_pf ? "/sys/bus/pci/devices/$intel_pf" : '';
$intel_vfs = $intel_base ? vgpu_read("$intel_base/sriov_numvfs") : '';
$intel_total = $intel_base ? vgpu_read("$intel_base/sriov_totalvfs") : '';
$vf_list = [];
if ($intel_base) foreach (glob("$intel_base/virtfn*") ?: [] as $vf) {
    $path = realpath($vf); if (!$path) continue;
    $driver = @readlink("$path/driver");
    $vf_list[] = [basename($path), $driver ? basename($driver) : ''];
}
$vfnum = vgpu_setting('intel_vf_number', '7');
$unlock_on = vgpu_setting('nvidia_unlock', vgpu_setting('unlock', 'false')) === 'true';
$override_content = (string)@file_get_contents("$vgpu_usercfg/profile_override.toml");
$new_uuid = bin2hex(random_bytes(16));
$new_uuid = substr($new_uuid,0,8).'-'.substr($new_uuid,8,4).'-4'.substr($new_uuid,13,3).'-8'.substr($new_uuid,17,3).'-'.substr($new_uuid,20,12);
$boot_kernel = vgpu_boot_kernel();
$pending_kernel = $boot_kernel !== '' && $boot_kernel !== $kernel ? $boot_kernel : '';
$upgrade = json_decode((string)@file_get_contents('/var/tmp/my-unraid-vgpu-manager-upgrade.json'), true) ?: [];
if ($pending_kernel !== '' && ($upgrade['kernel'] ?? '') !== $pending_kernel) $upgrade = [];
// An old readiness result cannot cover a newly enabled driver or another series.
if ($upgrade && (($nvidia_inst !== (($upgrade['nvidia'] ?? 'disabled') !== 'disabled')) ||
    ($intel_inst !== (($upgrade['intel'] ?? 'disabled') !== 'disabled')) ||
    ($nvidia_inst && $series_inst && ($upgrade['series'] ?? '') !== $series_inst) ||
    ($nvidia_inst && ($upgrade['wanted_version'] ?? 'latest') !== vgpu_setting('driver_version', 'latest')))) $upgrade = [];
if (($upgrade['status'] ?? '') === 'ready') {
    foreach (['nvidia','intel'] as $driver) {
        if (($upgrade[$driver] ?? '') !== 'ready') continue;
        $package = $upgrade[$driver.'_package'] ?? '';
        $cache = "$vgpu_cfgdir/packages/".explode('-', $upgrade['kernel'])[0].'/'.basename($package);
        if ($package === '' || !is_file($cache) || !is_file($cache.'.md5')) {
            $upgrade[$driver] = 'missing'; $upgrade['status'] = 'missing';
        }
    }
}
$target_kernel = $pending_kernel ?: (($upgrade['kernel'] ?? '') !== $kernel ? ($upgrade['kernel'] ?? '') : '');
$action_url = "/plugins/$vgpu_plugin/include/actions.php";
$labels = [];
foreach (['Profile','Type','Framebuffer','Displays','Max resolution','FRL','Free','No profiles are available on this GPU.','Select a profile first.','Remove this vGPU? Detach it from VMs first.','Stop GPU workloads before restarting NVIDIA services. Continue?','Uninstall NVIDIA? Stop GPU VMs and containers first.','Uninstall Intel i915 SR-IOV? Stop VMs using its VFs first.','Detach this vGPU from {vm}? Cold-start the VM to release it.','Copied.','Copy failed. Select and copy the XML manually.','The request failed. Refresh the page and check the result before retrying.','Enter a full Unraid kernel release, for example 6.18.47-Unraid.','Installing NVIDIA driver','Updating NVIDIA driver','Uninstalling NVIDIA driver','Restarting NVIDIA services','Installing Intel driver','Updating Intel driver','Uninstalling Intel driver','Preparing drivers for the next kernel'] as $label) $labels[$label] = vgpu_t($label);
?>
