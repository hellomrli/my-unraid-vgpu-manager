        if ($package === '' || !is_file($cache) || !is_file($cache.'.md5')) {
            $upgrade[$driver] = 'missing'; $upgrade['status'] = 'missing';
        }
    }
}
$show_upgrade = $pending_kernel !== '' && ($nvidia_inst || $intel_inst) && ($_GET['kernel_upgrade'] ?? '') === '1';
$updates = vgpu_driver_updates();
$license_server = vgpu_setting('nvidia_license_server');
$docker = json_decode((string)@file_get_contents('/etc/docker/daemon.json'), true) ?: [];
$docker_gpu = isset($docker['runtimes']['nvidia']);
$action_url = "/plugins/$vgpu_plugin/include/actions.php";
$labels = [];
foreach (['Profile','Type','Framebuffer','Displays','Max resolution','FRL','Free','No profiles are available on this GPU.','Select a profile first.','Remove this vGPU? Detach it from VMs first.','Stop GPU workloads before restarting NVIDIA services. Continue?','Uninstall NVIDIA? Stop GPU VMs and containers first.','Uninstall Intel i915 SR-IOV? Stop VMs using its VFs first.','Detach this vGPU from {vm}? Cold-start the VM to release it.','Copied.','Copy failed. Select and copy the XML manually.','The request failed. Refresh the page and check the result before retrying.','Enter a full Unraid kernel release, for example 6.18.47-Unraid.','Installing NVIDIA driver','Updating NVIDIA driver','Uninstalling NVIDIA driver','Restarting NVIDIA services','Installing Intel driver','Updating Intel driver','Uninstalling Intel driver','Preparing drivers for the next kernel', 'Checking for driver updates…', 'Could not check driver updates. Try again.', 'Driver update check timed out. Try again.', 'Another driver update check is running. Try again shortly.', 'Update check failed. Try again.', 'The page token expired. Refresh the page and try again.'] as $label) $labels[$label] = vgpu_t($label);
