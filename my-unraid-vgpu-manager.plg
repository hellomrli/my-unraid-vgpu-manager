<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "my-unraid-vgpu-manager">
  <!ENTITY author    "hellomrli">
  <!ENTITY version   "2026.09.09a">
  <!ENTITY launch    "Settings/my-unraid-vgpu-manager">
  <!ENTITY gitURL    "https://github.com/&author;/&name;/raw/master">
  <!ENTITY pluginURL "&gitURL;/&name;.plg">
  <!ENTITY md5       "a57afa96f5c996b9c8d3108372cc0fbe">
  <!ENTITY plugin    "/boot/config/plugins/&name;">
  <!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
  <!ENTITY packages  "/boot/config/plugins/&name;/packages">
]>

<PLUGIN  name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.11.5" support="https://github.com/&author;/&name;">

<CHANGES>
##2026.09.09a
- FIX: submit text forms using Unraid's URL-encoded format. Multipart FormData
  requests could stall in the native authentication subrequest before the
  plugin endpoint ran, even when GitHub and the driver check script were fast.
- FIX: apply the compatible encoding to both driver checks and settings/device
  forms, preserving CSRF tokens, Unicode, special characters and multiline text.
- TEST: verified automatic and manual checks in a real Unraid 7.4.0-beta.2
  WebUI; add browser coverage for native form encoding and CSRF consumption.

##2026.09.09
- FIX: driver update checks no longer open a PHP session just to read the
  interface language, avoiding waits on another Unraid request's session lock.
- FIX: bound metadata lookups and the whole web check process, including child
  processes. The browser stops waiting after 35 seconds and allows retry.
- FIX: handle stalled response bodies, expired page tokens and failed checks;
  hide stale update buttons and ignore responses arriving after a timeout.
- FIX: report a busy background check and keep one driver's network error from
  corrupting the other driver's result. Preserve the existing interface layout.

##2026.09.08a
- FIX: restore the original compact panels, tables, tabs and form layout.
- CHG: follow the Unraid interface language; remove the plugin language picker.
- CHG: show kernel-upgrade preparation only through an Unraid update
  notification while a different boot kernel is staged. Keep normal pages clear.
  Turning off automatic preparation still sends a reminder without downloading.
- ADD: driver status shows installed and available versions, including build
  numbers, with update buttons and a manual metadata check. Only enabled drivers
  are checked; NVIDIA updates stay within the installed series.
- FIX: invalidate update notices after installation, driver disable or kernel
  changes; report failed checks without claiming the driver is up to date.

##2026.09.08
- ADD: Simplified Chinese UI, English and follow-Unraid language selection.
- ADD: detect the next boot kernel from /boot/bzimage after an Unraid OS update.
  Download and verify packages only for GPU drivers the user already enabled;
  preserve the installed NVIDIA series, and notify before reboot if packages
  are missing or downloads fail. A post-update hook and a one-minute fallback
  check handle staged upgrades; the page also supports manual preparation.
- FIX: restore opted-in cached drivers for the running kernel at boot, before
  Docker/libvirt and VM autostart. No driver downloads occur during boot restore.
- FIX: explicit updates query GitHub and recognize same-version rebuilds.
  Failed downloads/checksums/installations no longer report success. Keep
  cached packages for current, next and rollback kernels and other drivers.
- FIX: check both persistent and active VM bindings; retain device definitions
  when stop/remove fails. Serialize GPU operations and validate submitted input.
- FIX: use sysfs PF/VF links, preserve existing VFs when the count is unchanged,
  enforce hardware limits and propagate driver/VF operation errors.
- FIX: saving general settings no longer resets vGPU unlock; refresh license
  tokens when the endpoint changes. Safe DOM rendering and HTTP clipboard fallback.
- ADD: reproducible plugin packaging and isolated lifecycle regression tests.

##2026.08.29b
- ADD: dual driver series support. The driver repo now publishes BOTH the
  16.x LTS (535.309.01) and the 19.x LTS (580.178.05) merged drivers for each
  Unraid kernel. After detecting the installed GPU model the plugin offers the
  matching series: Pascal cards (P4/P40/P100, dropped from branch 17 on) get
  16.x only, T4-and-newer GPUs get a choice with 19.x recommended, and GPUs
  supported by both get a series picker.
- ADD: "Driver series" setting (auto/16/19) in License &amp; Modules; the series
  is scoped through download, update-check, install and live-update (both
  series can coexist on the flash drive; auto follows the hardware).
- ADD: driver series shown on the status panels (installed series + what the
  hardware supports).
- NOTE: the vgpu_unlock kernel patch is only built into the 16.x series (the
  config magic is 535-specific). Native vGPU cards (P4 etc.) never need it.

##2026.08.29
- FIX: driver package cleanup no longer deletes the other driver type's
  package (nvidia and i915 share the packages/&lt;kernel&gt;/ directory) -
  installing Intel used to wipe the downloaded NVIDIA package, and the other
  way around.
- FIX: the i915 update check parsed the version out of "i915-sriov-&lt;ver&gt;-..."
  with cut -f2 (got "sriov" on both sides), so it never notified - now parsed
  with sed.
- FIX: the docker nvidia runtime is merged into an existing
  /etc/docker/daemon.json via jq instead of overwriting the user's config
  (registry-mirrors etc. survive). The driver package itself no longer ships
  a daemon.json - Unraid regenerates that file at docker service start, and
  nvidia-ctk configures the runtime at install/boot (clean driver builds:
  nvidia-...-6.18.47-Unraid-2 and -6.18.44-Unraid-3).
- FIX: nvidia-gridd now restarts when the license port/FeatureType/UI change,
  not only when the server address changes.
- FIX: VF passthrough binding loads vfio-pci first and binds via
  vfio-pci/bind; drivers_probe would probe every driverless PCI device.
- FIX: a stale /boot/config/modprobe.d/nvidia.conf with the invalid
  "cudahost=1" option (left by the old vgpu-driver plugin) is removed.
- FIX: Drivers tab VFs display showed n/a whenever sriov_totalvfs was set
  (duplicated condition in the template).
- (driver repo) the build now pins SHA256 of the NVIDIA .run files and the
  kernel archive, verifies the committed tools via SHA256SUMS, and skips
  dangling soname links.

##2026.08.21h
- ADD: "Attach vGPU to VM" section. Bind a vGPU mdev to a libvirt VM's
  persistent config via virsh (attach/detach), so the vGPU appears as a
  graphics card inside the VM - the Unraid VM editor cannot list mdev devices
  (they are not PCI devices), which this fills in.
- ADD: operation notes - attach/detach takes effect on the VM's next cold
  start; mdev cannot be hot-plugged.

##2026.08.21g
- CHG: Settings page tabs restyled as plain pagination buttons (no icons,
  no bold highlight) for a cleaner look.

##2026.08.21f
- REMOVE: invalid "options nvidia cudahost=1" from nvidia_setup_config.
  The MERGED driver needs no cudahost/vup_kunlock modprobe params (both are
  unknown to the kernel and ignored); vGPU + host CUDA coexistence comes from
  nvidia + nvidia-vgpu-vfio loading side by side.
- DOC: README updated with the three-tab layout and the merged-driver
  verification result.

##2026.08.21e
- ADD: Settings page split into three tabs:
  1. Drivers - driver status + install/uninstall NVIDIA &amp; Intel
  2. NVIDIA GPU - status, license/modules, vGPU devices, profile_override
  3. Intel i915 SR-IOV - status, VF count, passthrough, boot parameters

##2026.08.21d
- ADD: FastAPI-DLS licensing support. nvidia_apply_license now fetches the
  client token from https://&lt;server&gt;:&lt;port&gt;/-/client-token, writes it to
  /etc/nvidia/ClientConfigToken/client_configuration_token.tok, points
  ClientConfigTokenPath at that directory, creates /var/lib/nvidia/GridLicensing,
  and keeps nvidia-gridd running so Q-series vGPU profiles license correctly.
- ADD: Feature type is now a dropdown (0=vPC, 1=vWS, 2=RTX vWS/vDWS).
- NOTE: mdevctl is now bundled in the NVIDIA driver package (see
  my-nvidia-vgpu-driver) because Unraid ships no mdevctl.

##2026.08.21c
- FIX: Intel i915 SR-IOV driver now loads correctly. The i915-sriov module
  depends on intel_sriov_compat (intel_drm_shim_* symbols), which must be loaded
  FIRST - it now is. Also blacklists the stock i915 and unloads it if it was
  loaded without SR-IOV support, so the replacement takes over.
- FIX: i915 SR-IOV no longer relies on a manual modprobe in /boot/config/go.
  A boot event (emhttp started) now brings up both stacks automatically, and any
  leftover manual "modprobe i915" in go is neutralized (backup kept).
- FIX: i915 driver package now ships a doinst.sh so depmod runs automatically
  after install (was why intel_sriov_compat could not be found).

##2026.08.21b
- FIX: drivers were pre-downloaded on plugin install/update and by the daily
  update check. Now drivers are ONLY downloaded when you click Install on the
  plugin page. Installing/updating the plugin itself never touches your network
  or downloads any driver.

##2026.08.21a
- FIX: settings page was blank (white screen) - a bash-style ${var%:*} string
  was accidentally used inside PHP, causing a PHP parse error. Replaced with
  proper sysfs paths (/sys/bus/pci/devices/). The page now renders correctly.

##2026.08.21
- Unified vGPU manager: NVIDIA vGPU + Intel i915 SR-IOV in one plugin
- Drivers are NOT installed by default - choose Install from the plugin page
  (so systems that don't need vGPU stay untouched)
- NVIDIA: merged driver (vGPU for VMs + host GPU for docker/CUDA), license
  settings, unlock, vGPU device manager all in the plugin page
- Intel: i915 SR-IOV driver, VF count management, vfio-pci binding, syslinux
  boot parameters
- Driver packages come from the dedicated driver repos:
  hellomrli/my-nvidia-vgpu-driver (NVIDIA) and hellomrli/my-i915-sriov-driver (Intel)

##2026.08.20
- Initial release for the merged vGPU driver plugin
- MERGED driver: vGPU host driver + standard NVIDIA driver in one package,
  so the host GPU also works for docker containers (--gpus all), not just VMs
- Driver: NVIDIA vGPU 16.14 (535.309.01) for Unraid kernel 6.18.44
- Target GPU: Tesla P4 (native vGPU support, no unlock needed; unlock option
  kept for consumer GPUs)
- vGPU devices managed from the plugin page (add/remove/start/stop, live
  profile list, VM XML snippets), restored at every boot
- Driver updates install live without a reboot (when no VM holds a vGPU)
- vgpuConfig.xml override support for GPUs dropped from newer driver XMLs
- profile_override.toml editable from the plugin page

</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE>
**Unraid vGPU Manager / Unraid vGPU 管理器**

Manage NVIDIA vGPU and Intel i915 SR-IOV from Settings. 界面语言跟随 Unraid。
Drivers are installed on demand. OS upgrade preparation downloads only drivers
you already enabled, for the kernel staged on the boot drive, and reports their
readiness before reboot. Enabled packages are restored locally at the next boot.

在设置页面按需安装驱动。Unraid 更新后仅预下载您已启用的驱动，
核对新内核与校验结果并提示是否就绪；重启后从本地恢复对应驱动。
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
#!/bin/bash
source /usr/local/emhttp/plugins/my-unraid-vgpu-manager/include/common.sh
mkdir -p "$PLGCFG" || exit 1
# Migrate missing settings without opting an existing user into any driver.
for pair in first_installation=true driver_version=latest update_check=true \
  nvidia_installed=false intel_installed=false nvidia_series=auto unlock=false \
  nvidia_license_server= nvidia_license_port=443 nvidia_feature_type=0 \
  nvidia_license_verify=false nvidia_load_uvm=true nvidia_load_modeset=true \
  nvidia_load_drm=true intel_vf_number=7 kernel_upgrade_check=true; do
  key="${pair%%=*}"
  grep -q "^${key}=" "$SETTINGS" 2&gt;/dev/null || set_setting "$key" "${pair#*=}" || exit 1
done
# Preserve the old unlock key during migration.
if ! grep -q '^nvidia_unlock=' "$SETTINGS"; then set_setting nvidia_unlock "$(setting unlock)"; fi

# Old flat caches: infer each file's own kernel, not the running kernel.
for package in "$PLGCFG/packages/"*.txz; do
  [ -f "$package" ] || continue
  name="${package##*/}"
  if [[ "$name" =~ -([0-9]+\.[0-9]+\.[0-9]+)-Unraid-[0-9]+\.txz$ ]]; then
    dir="$PLGCFG/packages/${BASH_REMATCH[1]}"
    mkdir -p "$dir"
    mv -n -- "$package" "$dir/"
    [ ! -f "$package.md5" ] || mv -n -- "$package.md5" "$dir/"
  fi
done
"$EMHTTP/include/exec.sh" configure_cron || exit 1
# Unraid root files disappear at reboot. Restore only already enabled drivers
# from verified local caches; installation of this plugin does not opt in.
if ! "$EMHTTP/scripts/rc.vgpu" restore; then
  bilingual 'Some enabled GPU packages could not be restored. Open vGPU Manager to check the running kernel.' '部分已启用的 GPU 驱动未能恢复，请打开 vGPU 管理页面检查当前内核的驱动包。'
fi
if [ "$(setting first_installation)" = true ]; then
  vgpu_notify "$(bilingual 'Plugin installed. Open Settings &gt; Unraid vGPU Manager to install the GPU drivers you need.' '插件已安装，请到“设置 &gt; Unraid vGPU Manager”按需安装 GPU 驱动。')"
  set_setting first_installation false
fi
# Inspect a previously staged OS update without blocking plugin installation.
nohup "$EMHTTP/include/upgrade-check.sh" auto &gt;&gt;/var/log/my-unraid-vgpu-manager-upgrade.log 2&gt;&amp;1 &amp;
bilingual 'Unraid vGPU Manager is ready.' 'Unraid vGPU 管理器已就绪。'
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing Unraid vGPU Manager..."
# Remove only this plugin's scheduled commands.
crontab -l 2&gt;/dev/null | grep -Fv '/usr/local/emhttp/plugins/my-unraid-vgpu-manager/include/update-check.sh' | grep -Fv '/usr/local/emhttp/plugins/my-unraid-vgpu-manager/include/upgrade-check.sh' | crontab -
# A running VM may still hold a device; never force-stop it during plugin removal.
/bin/bash /usr/local/emhttp/plugins/my-unraid-vgpu-manager/scripts/rc.vgpu stop || true
rm -f /usr/local/emhttp/plugins/dynamix.plugin.manager/post-hooks/my-unraid-vgpu-manager
rm -f /boot/config/modprobe.d/my-unraid-vgpu-manager-i915.conf /etc/modprobe.d/my-unraid-vgpu-manager-i915.conf
rm -f /var/tmp/my-unraid-vgpu-manager-upgrade.json /var/tmp/my-unraid-vgpu-manager-updates.json /var/tmp/my-unraid-vgpu-manager-update-*
removepkg &name;-&version;
rm -rf /usr/local/emhttp/plugins/&name;
echo "Plugin removed. Reboot to unload drivers. Settings and driver caches remain on the flash drive."
</INLINE>
</FILE>
</PLUGIN>
